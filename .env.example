# Supabase — proyecto "LMS" (separado de LUMENS OS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sesión del portal (firma de cookies) — genera un valor random largo
PORTAL_SESSION_SECRET=

# Email del admin (Juan) — debe coincidir con el email con el que entra al portal
ADMIN_EMAIL=lumens.ecom@gmail.com

# Contraseña del admin para entrar por la pestaña "Soy admin" del portal
ADMIN_PASSWORD=

# ============================================================
# Asistente de estudio del portal
# ============================================================
# Basta con UNA de las dos claves. Si están las dos, manda Gemini.
# Sin ninguna, el asistente responde "no está configurado todavía" y el
# resto del portal funciona igual.

# Gemini — aistudio.google.com → Get API key
GEMINI_API_KEY=

# Opcional. Por defecto gemini-3.6-flash.
# OJO: gemini-2.5-flash ya no funciona con claves nuevas (404).
# Alternativa rápida: gemini-3.1-flash-lite (~1s vs ~3.5s, algo más flojo).
GEMINI_MODEL=

# NVIDIA — build.nvidia.com → Get API Key. Empieza por "nvapi-".
NVIDIA_API_KEY=

# Opcional. Por defecto nvidia/nemotron-3-super-120b-a12b.
NEMOTRON_MODEL=
