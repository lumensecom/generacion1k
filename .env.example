# Supabase — proyecto "LMS" (separado de LUMENS OS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sesión del portal (firma de cookies) — genera un valor random largo
PORTAL_SESSION_SECRET=

# Email del admin (Juan) — debe coincidir con el email con el que entra al portal
ADMIN_EMAIL=lumens.ecom@gmail.com

# Contraseña del admin para entrar por la pestaña "Soy admin" del portal
ADMIN_PASSWORD=

# Asistente de estudio — clave de NVIDIA (build.nvidia.com → Get API Key).
# Empieza por "nvapi-". Sin esto el asistente responde "no está configurado
# todavía"; el resto del portal funciona igual.
NVIDIA_API_KEY=

# Opcional: modelo a usar. Por defecto nvidia/nemotron-3-super-120b-a12b.
# Alternativas: nvidia/nemotron-3-nano-30b-a3b (más rápido y barato),
# nvidia/nemotron-3-ultra-550b-a55b (más capaz y lento).
NEMOTRON_MODEL=
